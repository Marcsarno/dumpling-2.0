{
  "name": "dumpling-three",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5200 --strictPort",
    "build": "node tools/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5201 --strictPort",
    "check": "tsc --noEmit && node scripts/verify-arianna-quality.mjs && node scripts/verify-lilah-quality.mjs && node tools/asset-manifest.mjs --verify && node tools/check-core-sync.mjs",
    "test": "node tools/run-tests.mjs",
    "assets:sync": "node tools/copy-assets.mjs",
    "convert": "node tools/convert-editor-scene.mjs",
    "baseline:playcanvas": "node tests/baseline/capture-playcanvas.mjs",
    "capture:three": "node tests/browser/capture-three.mjs",
    "test:browser": "node tests/browser/no-arianna-writes.mjs && node tests/browser/play-walk.mjs",
    "capture:motion": "node tests/browser/capture-motion.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
